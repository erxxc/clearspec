+    (tmp_config.paths.raw_dir / "ff00.extraction.json").write_bytes(b"\xff\xfe\x00garbage")
+    from semianalyst.extract import run_rebuild
+    rb = run_rebuild(tmp_config)
+    assert rb.folded == ["g1_doc"]
