+# Semiconductor Technical Release — Extraction Schema v3
+# Supersedes v2 (schema/extraction_schema_v2.yaml), which is retained unedited.
+#
+# What changed from v2 (analyze GATE-1 v2 resolution, 2026-07-20):
+#   * corroboration.status gains `weakly_corroborated` (NEW). A group of >=2
+#     claims that AGREE within tolerance but has fewer than 2 NON-SUSPECT members
+#     (e.g. a foundry's clean number + a vendor deck that honestly discloses
+#     sparsity) is not `corroborated` (a suspect number must not validate a clean
+#     one) yet is not `contradicted` (they agree) nor a singleton — the v2 3-value
+#     enum had no slot for this common, honest pattern.
+#
+# Everything else is identical to v2 (entity.attribute_citations, the `unknown`
+# location_type, per-attribute grounding, all other blocks). Only the changed
+# block is shown in full below; see extraction_schema_v2.yaml for the rest.
+
+# ---------------------------------------------------------------
+# CLAIM.corroboration — the divergence/agreement verdict (v3 enum)
+# ---------------------------------------------------------------
+claim:
+  # ... doc_id/entity_id/claim_class/metric/value/unit/comparison/conditions/
+  #     completeness/citation identical to v2 ...
+  corroboration:
+    status: enum              # [uncorroborated, corroborated,
+                              #  weakly_corroborated, contradicted]
+                              #  weakly_corroborated (v3): >=2 members agree within
+                              #  tolerance but <2 are non-suspect (sparsity /
+                              #  marketing_only rode along) — a hedged agreement.
+    related_claim_ids: [ref]  # the other members of this claim's group
+
+# All other blocks (document, citation, entity, macro_snapshot, normalization
+# rules) are unchanged from extraction_schema_v2.yaml.
