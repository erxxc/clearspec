+# --------------------------------------------------------------------------
+# doc_id slug — deterministic identity from the REQUESTED URL
+# --------------------------------------------------------------------------
+def test_url_doc_id_slug():
+    assert (url_doc_id("https://PR.TSMC.com/English/News/N2-Update.pdf")
+            == "pr_tsmc_com_english_news_n2_update_pdf")
